# Copied to .env by `make up` (which also fills SESSION_SECRET, POSTGRES_PASSWORD and
# UI_PASSWORD with random values when empty). .env is git-ignored: never commit it.

# Password for the web UI (http://localhost:8080).
UI_PASSWORD=
# Signs the login cookie. Random, at least 32 characters.
SESSION_SECRET=
# Database password (only used inside Docker). Set once: changing it later needs `make down` + volume reset.
POSTGRES_PASSWORD=

# LinkedIn login. Optional: without it, you log in yourself in the live browser.
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# AI provider keys (only the one for the provider chosen in Settings → AI is needed).
CLAUDE_API_KEY=
GLM_API_KEY=

# Time zone for dates in history.
TZ=UTC
